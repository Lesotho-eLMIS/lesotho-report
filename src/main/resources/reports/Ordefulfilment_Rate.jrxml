	<field name="Product" class="java.lang.String"/>
	<field name="Requisition Period" class="java.lang.String"/>
	<field name="Requested Quantity" class="java.lang.Integer"/>
	<field name="Quantity Recieved" class="java.lang.Integer"/>
	<field name="Date Received" class="java.sql.Timestamp"/>
	<field name="Order Fulfilment Rate" class="java.lang.Double"/>
	<field name="Discrepancy" class="java.lang.Double"/>
