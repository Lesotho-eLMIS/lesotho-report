	<property name="net.sf.jasperreports.export.csv.exclude.origin.band.2" value="pageFooter"/>

	<!-- Standardized OpenLMIS Parameters -->
	<parameter name="startDate" class="java.lang.String">
		<property name="displayName" value="Start Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="endDate" class="java.lang.String">
		<property name="displayName" value="End Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="facility" class="java.lang.String" nestedType="java.lang.String">
		<property name="displayName" value="Facility"/>
		<property name="required" value="false"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>

	<queryString language="SQL">
		<![CDATA[WITH req AS (
    SELECT
        r.id AS requisition_id,
        r.facilityid,
        r.processingperiodid,
        rli.orderableid,
        rli.requestedquantity
    FROM requisition.requisitions r
    JOIN requisition.requisition_line_items rli
        ON rli.requisitionid = r.id
),
recv AS (
    SELECT
        (seli.extradata::jsonb ->> 'requisition')::uuid AS requisition_id,
        seli.orderableid::uuid AS orderable_id,
        SUM(COALESCE(seli.quantity, 0)) AS quantity,
        MAX(seli.occurreddate) AS occurreddate
    FROM stockmanagement.stock_event_line_items seli
    WHERE (seli.extradata::jsonb ->> 'requisition') IS NOT NULL
      AND (
            $P{startDate} IS NULL OR $P{startDate} = ''
            OR seli.occurreddate >= TO_TIMESTAMP(NULLIF($P{startDate}, ''), 'YYYY-MM-DD')
          )
      AND (
            $P{endDate} IS NULL OR $P{endDate} = ''
            OR seli.occurreddate < (TO_TIMESTAMP(NULLIF($P{endDate}, ''), 'YYYY-MM-DD') + INTERVAL '1 day')
          )
    GROUP BY
        (seli.extradata::jsonb ->> 'requisition')::uuid,
        seli.orderableid::uuid
)
SELECT
    fac.name AS "Facility",
    o.fullproductname AS "Product",
    period.name AS "Requisition Period",
    req.requestedquantity AS "Requested Quantity",
    recv.quantity AS "Quantity Recieved",
    recv.occurreddate AS "Date Received",
    CASE
        WHEN req.requestedquantity IS NULL THEN NULL
        WHEN req.requestedquantity = 0 THEN 0
        ELSE ROUND(
            (COALESCE(recv.quantity, 0)::numeric / req.requestedquantity::numeric) * 100,
            2
        )
    END AS "Order Fulfilment Rate",
    COALESCE(recv.quantity, 0)::numeric - COALESCE(req.requestedquantity, 0)::numeric AS "Discrepancy"
FROM req
LEFT JOIN recv
    ON recv.requisition_id = req.requisition_id
   AND recv.orderable_id = req.orderableid
LEFT JOIN referencedata.facilities fac
    ON fac.id = req.facilityid
LEFT JOIN referencedata.orderables o
    ON o.id = req.orderableid
LEFT JOIN referencedata.processing_periods period
    ON period.id = req.processingperiodid
WHERE req.requestedquantity IS NOT NULL
  AND (
        $P{facility} IS NULL OR $P{facility} = ''
        OR fac.name = $P{facility}
      )
ORDER BY fac.name, period.name, o.fullproductname]]>
	</queryString>
