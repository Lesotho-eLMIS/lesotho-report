<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Redistribution_Report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail" uuid="dd11aa22-0000-0000-0000-000000000001">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="elmis"/>
	
	<!-- Clean Excel/CSV Export Properties -->
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.1" value="pageHeader"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.band.1" value="pageHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.band.2" value="pageFooter"/>

	<!-- Standardized OpenLMIS Parameters -->
	<parameter name="startDate" class="java.lang.String">
		<property name="displayName" value="Start Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="endDate" class="java.lang.String">
		<property name="displayName" value="End Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="facility" class="java.lang.String" nestedType="java.lang.String">
		<property name="displayName" value="Facility"/>
		<property name="required" value="false"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>

	<queryString language="SQL">
		<![CDATA[SELECT
    issufac.name                                        AS "Issuing Facility",
    issudis.name                                        AS "Issuing District",
    issufacty.name                                      AS "Issuing Facility Type",
    issufacop.name                                      AS "Issuing Ownership",
    prog.name                                           AS "Program",
    ord.fullproductname                                 AS "Product",
    lots.lotcode                                        AS "Batch Number",
    stcli.quantity                                      AS "Quantity",
    TO_CHAR(stcli.occurreddate, 'DD Month YYYY')        AS "Date Received",
    fac.name                                            AS "Receiving Facility",
    dis.name                                            AS "Receiving District",
    facty.name                                          AS "Receiving Facility Type",
    facop.name                                          AS "Receiving Ownership"
FROM stockmanagement.stock_card_line_items stcli
LEFT JOIN stockmanagement.stock_card_line_item_reasons stclir
    ON stcli.reasonid = stclir.id
LEFT JOIN stockmanagement.stock_cards stc
    ON stcli.stockcardid = stc.id
LEFT JOIN referencedata.orderables ord
    ON stc.orderableid = ord.id
LEFT JOIN referencedata.lots lots
    ON stc.lotid = lots.id
LEFT JOIN referencedata.program_orderables po
    ON ord.id = po.orderableid
LEFT JOIN referencedata.programs prog
    ON po.programid = prog.id
LEFT JOIN referencedata.facilities fac
    ON stc.facilityid = fac.id
LEFT JOIN referencedata.facility_types facty
    ON fac.typeid = facty.id
LEFT JOIN referencedata.facility_operators facop
    ON fac.operatedbyid = facop.id
LEFT JOIN referencedata.geographic_zones zone_fac
    ON zone_fac.id = fac.geographiczoneid
LEFT JOIN referencedata.geographic_zones dis
    ON zone_fac.parentid = dis.id
LEFT JOIN stockmanagement.nodes no
    ON stcli.sourceid = no.id
LEFT JOIN referencedata.facilities issufac
    ON CAST(no.referenceid AS uuid) = issufac.id
LEFT JOIN referencedata.geographic_zones zone_issufac
    ON zone_issufac.id = issufac.geographiczoneid
LEFT JOIN referencedata.geographic_zones issudis
    ON zone_issufac.parentid = issudis.id
LEFT JOIN referencedata.facility_types issufacty
    ON issufac.typeid = issufacty.id
LEFT JOIN referencedata.facility_operators issufacop
    ON issufac.operatedbyid = issufacop.id
WHERE stclir.id = 'e3fc3cf3-da18-44b0-a220-77c985202e06'
AND issufacty.id IN (
    '0fbe2b5c-bd2b-46af-ba7f-63c14add59c7',
    '1096849c-84cd-4a94-8a7a-25d9f6e3911b'
)
AND facty.id IN (
    '0fbe2b5c-bd2b-46af-ba7f-63c14add59c7',
    '1096849c-84cd-4a94-8a7a-25d9f6e3911b'
)
AND stcli.sourceid IS NOT NULL
AND (
    $P{startDate} IS NULL OR $P{startDate} = ''
    OR stcli.occurreddate >= TO_TIMESTAMP(NULLIF($P{startDate}, ''), 'YYYY-MM-DD')
)
AND (
    $P{endDate} IS NULL OR $P{endDate} = ''
    OR stcli.occurreddate < (TO_TIMESTAMP(NULLIF($P{endDate}, ''), 'YYYY-MM-DD') + INTERVAL '1 day')
)
AND (
    $P{facility} IS NULL OR $P{facility} = ''
    OR issufac.name = $P{facility}
)
ORDER BY issudis.name, issufac.name, dis.name, fac.name, stcli.occurreddate]]>
	</queryString>
