<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Orderfill_rate" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="elmis"/>
	
	<parameter name="startDate" class="java.lang.String">
		<property name="displayName" value="Start Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	
	<parameter name="endDate" class="java.lang.String">
		<property name="displayName" value="End Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	
	<parameter name="facility" class="java.lang.String">
		<property name="displayName" value="Facility Name"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>

	<parameter name="district" class="java.lang.String" nestedType="java.lang.String">
		<property name="displayName" value="District"/>
		<property name="required" value="false"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>

	
	<parameter name="userId" class="java.lang.String">
		<property name="displayName" value="User ID"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	
	<queryString language="SQL">
		<![CDATA[
WITH req AS (
    SELECT
        r.id AS requisition_id,
        r.facilityid,
        r.processingperiodid,
        rli.orderableid,
        rli.requestedquantity
    FROM requisition.requisitions r
    JOIN requisition.requisition_line_items rli ON rli.requisitionid = r.id
    WHERE EXISTS (
        SELECT 1 
        FROM referencedata.right_assignments ra
        WHERE ra.rightname = 'STOCK_CARDS_VIEW'
        AND ra.userId = $P{userId}::uuid
        AND ra.facilityid = r.facilityid
    )
),
recv AS (
    SELECT
        (seli.extradata::jsonb ->> 'requisition')::uuid AS requisition_id,
        seli.orderableid::uuid AS orderable_id,
        SUM(COALESCE(seli.quantity, 0)) AS quantity,
        MAX(seli.occurreddate) AS occurreddate
    FROM stockmanagement.stock_event_line_items seli
    WHERE (seli.extradata::jsonb ->> 'requisition') IS NOT NULL
    AND ($P{startDate} IS NULL OR $P{startDate} = '' OR seli.occurreddate >= TO_TIMESTAMP(NULLIF($P{startDate}, ''), 'YYYY-MM-DD'))
    AND ($P{endDate} IS NULL OR $P{endDate} = '' OR seli.occurreddate < (TO_TIMESTAMP(NULLIF($P{endDate}, ''), 'YYYY-MM-DD') + INTERVAL '1 day'))
    GROUP BY (seli.extradata::jsonb ->> 'requisition')::uuid, seli.orderableid::uuid
)
SELECT
    fac.name AS facility,
    o.fullproductname AS product,
    period.name AS requisition_period,
    req.requestedquantity AS requested_quantity,
    recv.quantity AS quantity_received,
    recv.occurreddate AS date_received,
    CASE
        WHEN req.requestedquantity IS NULL THEN NULL
        WHEN req.requestedquantity = 0 THEN 0
        ELSE ROUND((COALESCE(recv.quantity, 0)::numeric / req.requestedquantity::numeric) * 100, 2)
    END AS order_fill_rate,
    COALESCE(recv.quantity, 0)::numeric - COALESCE(req.requestedquantity, 0)::numeric AS discrepancy
FROM req
LEFT JOIN recv ON recv.requisition_id = req.requisition_id AND recv.orderable_id = req.orderableid
LEFT JOIN referencedata.facilities fac ON fac.id = req.facilityid
LEFT JOIN referencedata.geographic_zones zone_fac ON zone_fac.id = fac.geographiczoneid
LEFT JOIN referencedata.geographic_zones dis ON dis.id = zone_fac.parentid
LEFT JOIN referencedata.orderables o ON o.id = req.orderableid
LEFT JOIN referencedata.processing_periods period ON period.id = req.processingperiodid
WHERE req.requestedquantity IS NOT NULL
AND ($P{facility} IS NULL OR $P{facility} = '' OR fac.name = $P{facility})
AND ($P{district} IS NULL OR $P{district} = '' OR dis.name = $P{district})
ORDER BY fac.name, period.name, o.fullproductname]]>
	</queryString>
	
	<field name="facility" class="java.lang.String"/>
	<field name="product" class="java.lang.String"/>
	<field name="requisition_period" class="java.lang.String"/>
	<field name="requested_quantity" class="java.lang.Integer"/>
	<field name="quantity_received" class="java.lang.Integer"/>
	<field name="date_received" class="java.sql.Timestamp"/>
	<field name="order_fill_rate" class="java.lang.Double"/>
	<field name="discrepancy" class="java.lang.Double"/>
	
