<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Emergency_Orders" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ee100000-0000-0000-0000-000000000001" whenNoDataType="AllSectionsNoDetail">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="elmis"/>
	<parameter name="startDate" class="java.lang.String">
        <property name="displayName" value="Start Date"/>
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    
    <parameter name="endDate" class="java.lang.String">
        <property name="displayName" value="End Date"/>
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    
    <parameter name="facility" class="java.lang.String" nestedType="java.lang.String">
        <property name="displayName" value="Facility"/>
        <property name="required" value="false"/>
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

	<parameter name="district" class="java.lang.String" nestedType="java.lang.String">
		<property name="displayName" value="District"/>
		<property name="required" value="false"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>

	<queryString language="SQL">
		<![CDATA[SELECT
    CASE
        WHEN LOWER(COALESCE(dis.name, '')) = 'lesotho' THEN geoz.name
        ELSE COALESCE(dis.name, geoz.name)
    END                                                     AS "District",
    fac.name                                                AS "Facility Name",
    facty.name                                              AS facility_type,
    facop.name                                              AS facility_operator,
    prog.name                                               AS program,
    ord.fullproductname                                     AS full_product_name,
    reqli.requestedquantity                                 AS "Quantity Requested",
    req.status,
    TO_CHAR(req.createddate::timestamp, 'DD Month YYYY')    AS "Occurred Date",
    period.name                                             AS "Reporting Period"
FROM requisition.requisitions req
LEFT JOIN referencedata.facilities fac
    ON req.facilityid = fac.id
LEFT JOIN referencedata.facility_types facty
    ON fac.typeid = facty.id
LEFT JOIN referencedata.facility_operators facop
    ON fac.operatedbyid = facop.id
LEFT JOIN referencedata.programs prog
    ON req.programid = prog.id
LEFT JOIN referencedata.geographic_zones geoz
    ON geoz.id = fac.geographiczoneid
LEFT JOIN referencedata.geographic_zones dis
    ON geoz.parentid = dis.id
LEFT JOIN referencedata.processing_periods period
    ON req.processingperiodid = period.id
LEFT JOIN requisition.requisition_line_items reqli
    ON req.id = reqli.requisitionid
LEFT JOIN referencedata.orderables ord
    ON reqli.orderableid = ord.id
WHERE req.emergency = true
AND req.status IN ('APPROVED')
AND (
    $P{startDate} IS NULL OR $P{startDate} = '' OR $P{startDate} = 'undefined'
    OR req.createddate >= TO_TIMESTAMP(NULLIF($P{startDate}, ''), 'YYYY-MM-DD')
)
AND (
    $P{endDate} IS NULL OR $P{endDate} = '' OR $P{endDate} = 'undefined'
    OR req.createddate < (TO_TIMESTAMP(NULLIF($P{endDate}, ''), 'YYYY-MM-DD') + INTERVAL '1 day')
)
AND (
    $P{facility} IS NULL OR $P{facility} = '' OR $P{facility} = 'undefined'
    OR fac.name = $P{facility}
)
AND (
    $P{district} IS NULL OR $P{district} = '' OR $P{district} = 'undefined'
    OR CASE
        WHEN LOWER(COALESCE(dis.name, '')) = 'lesotho' THEN geoz.name
        ELSE COALESCE(dis.name, geoz.name)
       END = $P{district}
)
ORDER BY
    CASE
        WHEN LOWER(COALESCE(dis.name, '')) = 'lesotho' THEN geoz.name
        ELSE COALESCE(dis.name, geoz.name)
    END,
    fac.name,
    prog.name,
    period.name]]>
	</queryString>
