	<queryString language="SQL">
		<![CDATA[WITH params AS (
    SELECT
        CASE WHEN p.start_date ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN p.start_date::date END AS start_date,
        CASE WHEN p.end_date ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN p.end_date::date END AS end_date,
        NULLIF(NULLIF(NULLIF(TRIM(p.district), ''), 'undefined'), 'null') AS district,
        CASE WHEN COALESCE(TRIM(p.facilities), '') IN ('', 'undefined', 'null') THEN NULL
             ELSE NULLIF(ARRAY(SELECT TRIM(x) FROM unnest(string_to_array(p.facilities, '|')) AS x WHERE TRIM(x) <> ''), '{}') END AS facilities
    FROM (SELECT $P{startDate}::text AS start_date,
           $P{endDate}::text AS end_date,
           $P{district}::text AS district,
           $P{facility}::text AS facilities
          OFFSET 0) AS p
),
facility_info AS (
    -- One row per facility with its district, resolved the same way as the reports page:
    -- the nearest zone named after one of the ten districts, else the zone at the district
    -- level, else the facility's parent zone (or its own zone when the parent is Lesotho).
    SELECT
        f.id,
        f.name,
        f.code,
        f.active,
        ft.id AS type_id,
        ft.name AS type_name,
        fo.name AS operator_name,
        COALESCE(
            (SELECT z.name
             FROM unnest(ARRAY[z1.name, z2.name, z3.name, z4.name]) WITH ORDINALITY AS z(name, ord)
             WHERE regexp_replace(LOWER(z.name), '[^a-z]', '', 'g') IN ('berea', 'buthabuthe', 'leribe', 'mafeteng', 'maseru', 'mohaleshoek', 'mokhotlong', 'qachasneck', 'qachasnek', 'quthing', 'thabatseka')
             ORDER BY z.ord
             LIMIT 1),
            CASE
                WHEN LOWER(l1.code) = 'district' OR l1.levelnumber = 3 THEN z1.name
                WHEN LOWER(l2.code) = 'district' OR l2.levelnumber = 3 THEN z2.name
                WHEN LOWER(l3.code) = 'district' OR l3.levelnumber = 3 THEN z3.name
            END,
            CASE WHEN z2.id IS NULL OR LOWER(z2.name) = 'lesotho' THEN z1.name ELSE z2.name END
        ) AS district,
        ARRAY[LOWER(z1.name), LOWER(z2.name), LOWER(z3.name), LOWER(z4.name)] AS zones
    FROM referencedata.facilities f
    LEFT JOIN referencedata.facility_types ft ON ft.id = f.typeid
    LEFT JOIN referencedata.facility_operators fo ON fo.id = f.operatedbyid
    LEFT JOIN referencedata.geographic_zones z1 ON z1.id = f.geographiczoneid
    LEFT JOIN referencedata.geographic_levels l1 ON l1.id = z1.levelid
    LEFT JOIN referencedata.geographic_zones z2 ON z2.id = z1.parentid
    LEFT JOIN referencedata.geographic_levels l2 ON l2.id = z2.levelid
    LEFT JOIN referencedata.geographic_zones z3 ON z3.id = z2.parentid
    LEFT JOIN referencedata.geographic_levels l3 ON l3.id = z3.levelid
    LEFT JOIN referencedata.geographic_zones z4 ON z4.id = z3.parentid
),
selected_facilities AS (
    -- Facilities matching the District and Facility filters
    SELECT fi.*
    FROM facility_info fi
    CROSS JOIN params p
    WHERE (p.district IS NULL
           OR LOWER(p.district) = LOWER(fi.district)
           OR LOWER(p.district) = ANY (fi.zones))
      AND (p.facilities IS NULL OR fi.name = ANY (p.facilities))
),
products AS (
    -- Latest version of each product (products are versioned)
    SELECT DISTINCT ON (o.id) o.id, o.code, o.fullproductname
    FROM referencedata.orderables o
    ORDER BY o.id, o.versionnumber DESC
),
stock_activity AS (
    -- Stock events in the period, with the reason of each line (or of each stock-count adjustment)
    SELECT se.facilityid, se.processeddate, COALESCE(r_line.name, r_count.name) AS reason
    FROM stockmanagement.stock_events se
    CROSS JOIN params p
    JOIN stockmanagement.stock_event_line_items seli ON seli.stockeventid = se.id
    LEFT JOIN stockmanagement.stock_card_line_item_reasons r_line ON r_line.id = seli.reasonid
    LEFT JOIN stockmanagement.physical_inventory_line_item_adjustments pili ON pili.stockeventlineitemid = seli.id
    LEFT JOIN stockmanagement.stock_card_line_item_reasons r_count ON r_count.id = pili.reasonid
    WHERE se.facilityid IN (SELECT id FROM selected_facilities)
      AND (p.start_date IS NULL OR se.processeddate::date >= p.start_date)
      AND (p.end_date IS NULL OR se.processeddate::date <= p.end_date)
),
stock AS (
    SELECT
        facilityid,
        MAX(processeddate) FILTER (WHERE reason = 'Consumed') AS r_consumed,
        MAX(processeddate) FILTER (WHERE reason = 'Beginning Balance Insufficiency') AS r_beginning_balance_insufficiency,
        MAX(processeddate) FILTER (WHERE reason = 'Facility Return') AS r_facility_return,
        MAX(processeddate) FILTER (WHERE reason = 'Stolen') AS r_stolen,
        MAX(processeddate) FILTER (WHERE reason = 'Beginning Balance Excess') AS r_beginning_balance_excess,
        MAX(processeddate) FILTER (WHERE reason = 'Lost') AS r_lost,
        MAX(processeddate) FILTER (WHERE reason = 'POD Query') AS r_pod_query,
        MAX(processeddate) FILTER (WHERE reason = 'Damage') AS r_damage,
        MAX(processeddate) FILTER (WHERE reason = 'Expired') AS r_expired,
        MAX(processeddate) FILTER (WHERE reason = 'Unusable') AS r_unusable,
        MAX(processeddate) FILTER (WHERE reason = 'Degraded') AS r_degraded,
        MAX(processeddate) FILTER (WHERE reason = 'Unpack Kit') AS r_unpack_kit,
        MAX(processeddate) FILTER (WHERE reason = 'Transfer In') AS r_transfer_in,
        MAX(processeddate) FILTER (WHERE reason = 'Unpacked From Kit') AS r_unpacked_from_kit,
        MAX(processeddate) FILTER (WHERE reason = 'Transfer Out') AS r_transfer_out,
        MAX(processeddate) FILTER (WHERE reason = 'Cold Chain Failure') AS r_cold_chain_failure,
        MAX(processeddate) FILTER (WHERE reason = 'Passed Open-vial Time Limit') AS r_passed_open_vial_time_limit,
        MAX(processeddate) FILTER (WHERE reason = 'Recalled') AS r_recalled,
        MAX(processeddate) FILTER (WHERE reason = 'Over Supply') AS r_over_supply,
        MAX(processeddate) FILTER (WHERE reason = 'Receipts') AS r_receipts,
        MAX(processeddate) FILTER (WHERE reason = 'Expiry') AS r_expiry,
        MAX(processeddate) FILTER (WHERE reason = 'Damaged') AS r_damaged,
        MAX(processeddate) FILTER (WHERE reason = 'Internal Transfer Out') AS r_internal_transfer_out,
        MAX(processeddate) FILTER (WHERE reason = 'Internal Transfer In') AS r_internal_transfer_in,
        MAX(processeddate) AS last_stock_event
    FROM stock_activity
    GROUP BY facilityid
),
requisitions AS (
    SELECT r.facilityid, MAX(sc.createddate)::timestamp AS last_requisition
    FROM requisition.requisitions r
    JOIN requisition.status_changes sc ON sc.requisitionid = r.id
    CROSS JOIN params p
    WHERE sc.status IN ('INITIATED', 'SUBMITTED', 'AUTHORIZED')
      AND r.facilityid IN (SELECT id FROM selected_facilities)
      AND (p.start_date IS NULL OR sc.createddate::date >= p.start_date)
      AND (p.end_date IS NULL OR sc.createddate::date <= p.end_date)
    GROUP BY r.facilityid
),
fulfillment AS (
    SELECT o.facilityid, GREATEST(MAX(o.createddate), MAX(sh.shippeddate))::timestamp AS last_fulfillment
    FROM fulfillment.orders o
    LEFT JOIN fulfillment.shipments sh ON sh.orderid = o.id
    CROSS JOIN params p
    WHERE o.facilityid IN (SELECT id FROM selected_facilities)
      AND (p.start_date IS NULL OR o.createddate::date >= p.start_date)
      AND (p.end_date IS NULL OR o.createddate::date <= p.end_date)
    GROUP BY o.facilityid
)
SELECT
    sf.district,
    sf.name AS facility,
    sf.type_name AS facility_type,
    st.r_consumed,
    st.r_beginning_balance_insufficiency,
    st.r_facility_return,
    st.r_stolen,
    st.r_beginning_balance_excess,
    st.r_lost,
    st.r_pod_query,
    st.r_damage,
    st.r_expired,
    st.r_unusable,
    st.r_degraded,
    st.r_unpack_kit,
    st.r_transfer_in,
    st.r_unpacked_from_kit,
    st.r_transfer_out,
    st.r_cold_chain_failure,
    st.r_passed_open_vial_time_limit,
    st.r_recalled,
    st.r_over_supply,
    st.r_receipts,
    st.r_expiry,
    st.r_damaged,
    st.r_internal_transfer_out,
    st.r_internal_transfer_in,
    rq.last_requisition,
    fu.last_fulfillment,
    GREATEST(st.last_stock_event, rq.last_requisition, fu.last_fulfillment) AS last_activity
FROM selected_facilities sf
LEFT JOIN stock st ON st.facilityid = sf.id
LEFT JOIN requisitions rq ON rq.facilityid = sf.id
LEFT JOIN fulfillment fu ON fu.facilityid = sf.id
WHERE sf.active = true
ORDER BY sf.district, sf.name]]>
	</queryString>
