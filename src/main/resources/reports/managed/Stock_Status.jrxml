	<pageHeader>
		<band height="30" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="5" width="48" height="20" uuid="d3b960a6-dc8e-5433-a8fc-983ff243f3b4"/>
				<textElement><font size="7" isBold="true"/></textElement>
				<text><![CDATA[Start Date:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="48" y="5" width="119" height="20" uuid="4cf8d4e8-a587-54a0-9647-a32d8736efa5"/>
				<textElement><font size="7"/></textElement>
				<textFieldExpression><![CDATA[($P{startDate} != null && $P{startDate}.matches("\\d{4}-\\d{2}-\\d{2}") ? new java.text.SimpleDateFormat("dd MMM yyyy").format(java.sql.Date.valueOf($P{startDate})) : null) != null ? ($P{startDate} != null && $P{startDate}.matches("\\d{4}-\\d{2}-\\d{2}") ? new java.text.SimpleDateFormat("dd MMM yyyy").format(java.sql.Date.valueOf($P{startDate})) : null) : ((($P{startDate} == null || $P{startDate}.trim().isEmpty() || $P{startDate}.equals("undefined") || $P{startDate}.equals("null")) && ($P{endDate} == null || $P{endDate}.trim().isEmpty() || $P{endDate}.equals("undefined") || $P{endDate}.equals("null"))) ? "Latest month" : "All")]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="171" y="5" width="40" height="20" uuid="58d23b05-0404-5ed6-abc3-06ebcb2a667c"/>
				<textElement><font size="7" isBold="true"/></textElement>
				<text><![CDATA[End Date:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
