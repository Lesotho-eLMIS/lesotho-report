	<queryString language="SQL">
		<![CDATA[WITH params AS (
    SELECT
        CASE WHEN p.start_date ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN p.start_date::date END AS start_date,
        CASE WHEN p.end_date ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN p.end_date::date END AS end_date,
        NULLIF(NULLIF(NULLIF(TRIM(p.district), ''), 'undefined'), 'null') AS district,
        CASE WHEN COALESCE(TRIM(p.facilities), '') IN ('', 'undefined', 'null') THEN NULL
             ELSE NULLIF(ARRAY(SELECT TRIM(x) FROM unnest(string_to_array(p.facilities, '|')) AS x WHERE TRIM(x) <> ''), '{}') END AS facilities,
        CASE WHEN COALESCE(TRIM(p.programs), '') IN ('', 'undefined', 'null') THEN NULL
             ELSE NULLIF(ARRAY(SELECT TRIM(x) FROM unnest(string_to_array(p.programs, '|')) AS x WHERE TRIM(x) <> ''), '{}') END AS programs,
        CASE WHEN COALESCE(TRIM(p.products), '') IN ('', 'undefined', 'null') THEN NULL
             ELSE NULLIF(ARRAY(SELECT TRIM(x) FROM unnest(string_to_array(p.products, '|')) AS x WHERE TRIM(x) <> ''), '{}') END AS products
    FROM (SELECT $P{startDate}::text AS start_date,
           $P{endDate}::text AS end_date,
           $P{district}::text AS district,
           $P{facility}::text AS facilities,
           $P{program}::text AS programs,
           $P{product}::text AS products
          OFFSET 0) AS p
),
facility_info AS (
    -- One row per facility with its district, resolved the same way as the reports page:
    -- the nearest zone named after one of the ten districts, else the zone at the district
    -- level, else the facility's parent zone (or its own zone when the parent is Lesotho).
    SELECT
        f.id,
        f.name,
        f.code,
        f.active,
        ft.id AS type_id,
        ft.name AS type_name,
        fo.name AS operator_name,
        COALESCE(
            (SELECT z.name
             FROM unnest(ARRAY[z1.name, z2.name, z3.name, z4.name]) WITH ORDINALITY AS z(name, ord)
             WHERE regexp_replace(LOWER(z.name), '[^a-z]', '', 'g') IN ('berea', 'buthabuthe', 'leribe', 'mafeteng', 'maseru', 'mohaleshoek', 'mokhotlong', 'qachasneck', 'qachasnek', 'quthing', 'thabatseka')
             ORDER BY z.ord
             LIMIT 1),
            CASE
                WHEN LOWER(l1.code) = 'district' OR l1.levelnumber = 3 THEN z1.name
                WHEN LOWER(l2.code) = 'district' OR l2.levelnumber = 3 THEN z2.name
                WHEN LOWER(l3.code) = 'district' OR l3.levelnumber = 3 THEN z3.name
            END,
            CASE WHEN z2.id IS NULL OR LOWER(z2.name) = 'lesotho' THEN z1.name ELSE z2.name END
        ) AS district,
        ARRAY[LOWER(z1.name), LOWER(z2.name), LOWER(z3.name), LOWER(z4.name)] AS zones
    FROM referencedata.facilities f
    LEFT JOIN referencedata.facility_types ft ON ft.id = f.typeid
    LEFT JOIN referencedata.facility_operators fo ON fo.id = f.operatedbyid
    LEFT JOIN referencedata.geographic_zones z1 ON z1.id = f.geographiczoneid
    LEFT JOIN referencedata.geographic_levels l1 ON l1.id = z1.levelid
    LEFT JOIN referencedata.geographic_zones z2 ON z2.id = z1.parentid
    LEFT JOIN referencedata.geographic_levels l2 ON l2.id = z2.levelid
    LEFT JOIN referencedata.geographic_zones z3 ON z3.id = z2.parentid
    LEFT JOIN referencedata.geographic_levels l3 ON l3.id = z3.levelid
    LEFT JOIN referencedata.geographic_zones z4 ON z4.id = z3.parentid
),
selected_facilities AS (
    -- Facilities matching the District and Facility filters
    SELECT fi.*
    FROM facility_info fi
    CROSS JOIN params p
    WHERE (p.district IS NULL
           OR LOWER(p.district) = LOWER(fi.district)
           OR LOWER(p.district) = ANY (fi.zones))
      AND (p.facilities IS NULL OR fi.name = ANY (p.facilities))
),
products AS (
    -- Latest version of each product (products are versioned)
    SELECT DISTINCT ON (o.id) o.id, o.code, o.fullproductname
    FROM referencedata.orderables o
    ORDER BY o.id, o.versionnumber DESC
),
current_month AS (
    -- P0: each regular monthly requisition in the selected months
    SELECT
        per.name AS reporting_month,
        per.startdate,
        per.enddate,
        per.processingscheduleid,
        r.facilityid,
        r.programid,
        r.id AS requisition_p0,
        per.id AS period_p0
    FROM requisition.requisitions r
    JOIN selected_facilities sf ON sf.id = r.facilityid
    JOIN referencedata.processing_periods per ON per.id = r.processingperiodid
    JOIN referencedata.processing_schedules ps ON ps.id = per.processingscheduleid
    CROSS JOIN params p
    LEFT JOIN referencedata.programs prog ON prog.id = r.programid
    WHERE ps.name = 'Monthly'
      AND r.emergency = false
      AND (p.start_date IS NULL OR per.startdate >= p.start_date)
      AND (p.end_date IS NULL OR per.startdate <= p.end_date)
      -- No dates chosen: only the latest month that has requisitions (not every month ever)
      AND (p.start_date IS NOT NULL OR p.end_date IS NOT NULL OR per.startdate = (
            SELECT MAX(per2.startdate)
            FROM requisition.requisitions r2
            JOIN referencedata.processing_periods per2 ON per2.id = r2.processingperiodid
            JOIN referencedata.processing_schedules ps2 ON ps2.id = per2.processingscheduleid
            WHERE ps2.name = 'Monthly' AND r2.emergency = false AND per2.startdate <= CURRENT_DATE))
      AND (p.programs IS NULL OR prog.name = ANY (p.programs))
),
months AS (
    -- P-1 and P-2: the two monthly periods before P0, and their regular requisitions
    SELECT cm.*,
        p1.id AS period_p1, p1.name AS reporting_month_p1, p1.startdate AS start_p1, p1.enddate AS end_p1,
        p2.id AS period_p2, p2.name AS reporting_month_p2, p2.startdate AS start_p2, p2.enddate AS end_p2,
        (SELECT r1.id FROM requisition.requisitions r1
         WHERE r1.facilityid = cm.facilityid AND r1.programid = cm.programid
           AND r1.processingperiodid = p1.id AND r1.emergency = false
         ORDER BY r1.createddate DESC LIMIT 1) AS requisition_p1,
        (SELECT r2.id FROM requisition.requisitions r2
         WHERE r2.facilityid = cm.facilityid AND r2.programid = cm.programid
           AND r2.processingperiodid = p2.id AND r2.emergency = false
         ORDER BY r2.createddate DESC LIMIT 1) AS requisition_p2
    FROM current_month cm
    LEFT JOIN LATERAL (
        SELECT pp.* FROM referencedata.processing_periods pp
        WHERE pp.processingscheduleid = cm.processingscheduleid AND pp.startdate < cm.startdate
        ORDER BY pp.startdate DESC LIMIT 1) p1 ON true
    LEFT JOIN LATERAL (
        SELECT pp.* FROM referencedata.processing_periods pp
        WHERE pp.processingscheduleid = cm.processingscheduleid AND pp.startdate < cm.startdate
        ORDER BY pp.startdate DESC OFFSET 1 LIMIT 1) p2 ON true
),
needed AS (
    -- The facility/program/month combinations that need stock-card figures
    SELECT DISTINCT m.facilityid, m.programid, x.period_id, x.startdate, x.enddate
    FROM months m
    CROSS JOIN LATERAL (VALUES (m.period_p0, m.startdate, m.enddate),
                               (m.period_p1, m.start_p1, m.end_p1),
                               (m.period_p2, m.start_p2, m.end_p2)) AS x(period_id, startdate, enddate)
    WHERE x.period_id IS NOT NULL
),
needed_cards AS (
    -- Stock cards (all batches) for those facility/program/months, limited to the selected products
    SELECT n.period_id, n.startdate, n.enddate, sc.id AS card_id, sc.facilityid, sc.programid, sc.orderableid
    FROM needed n
    JOIN stockmanagement.stock_cards sc ON sc.facilityid = n.facilityid AND sc.programid = n.programid
    CROSS JOIN params p
    LEFT JOIN products pr ON pr.id = sc.orderableid
    WHERE (p.products IS NULL OR pr.fullproductname = ANY (p.products))
),
moves AS (
    -- QR: received from NDSO during the month;  TI: transfers in during the month
    SELECT nc.period_id, nc.card_id,
        SUM(CASE WHEN rsn.name = 'Receipts' AND scli.sourceid = '583bb7fa-496f-42d0-8858-529f0301565c' THEN scli.quantity ELSE 0 END) AS qr,
        SUM(CASE WHEN scli.reasonid = 'e3fc3cf3-da18-44b0-a220-77c985202e06' THEN scli.quantity ELSE 0 END)
          + COALESCE(SUM(adj.quantity), 0) AS ti
    FROM needed_cards nc
    JOIN stockmanagement.stock_card_line_items scli
      ON scli.stockcardid = nc.card_id AND scli.occurreddate BETWEEN nc.startdate AND nc.enddate
    LEFT JOIN stockmanagement.stock_card_line_item_reasons rsn ON rsn.id = scli.reasonid
    LEFT JOIN (SELECT pili.stockcardlineitemid, SUM(pili.quantity) AS quantity
               FROM stockmanagement.physical_inventory_line_item_adjustments pili
               WHERE pili.reasonid = 'e3fc3cf3-da18-44b0-a220-77c985202e06'
               GROUP BY pili.stockcardlineitemid) adj ON adj.stockcardlineitemid = scli.id
    GROUP BY nc.period_id, nc.card_id
),
soh_days AS (
    -- Official stock on hand per card per day (latest entry of the day)
    SELECT DISTINCT ON (cs.stockcardid, cs.occurreddate) cs.stockcardid, cs.occurreddate, cs.stockonhand
    FROM stockmanagement.calculated_stocks_on_hand cs
    WHERE cs.stockcardid IN (SELECT card_id FROM needed_cards)
      AND cs.occurreddate <= (SELECT MAX(enddate) FROM needed)
    ORDER BY cs.stockcardid, cs.occurreddate, cs.processeddate DESC
),
soh_ranges AS (
    -- Each balance is valid from its day until the next change
    SELECT sd.*, LEAD(sd.occurreddate) OVER (PARTITION BY sd.stockcardid ORDER BY sd.occurreddate) AS next_day
    FROM soh_days sd
),
stock_figures AS NOT MATERIALIZED (
    -- Inlined so PostgreSQL (12+) can hash-join it to the report lines.
    -- SH: closing stock on hand at the end of the month (all batches); QR and TI as above
    SELECT nc.period_id, nc.facilityid, nc.programid, nc.orderableid,
        SUM(sr.stockonhand) AS sh,
        COALESCE(SUM(m.qr), 0) AS qr,
        COALESCE(SUM(m.ti), 0) AS ti
    FROM needed_cards nc
    LEFT JOIN soh_ranges sr
      ON sr.stockcardid = nc.card_id AND sr.occurreddate <= nc.enddate
     AND (sr.next_day IS NULL OR sr.next_day > nc.enddate)
    LEFT JOIN moves m ON m.period_id = nc.period_id AND m.card_id = nc.card_id
    GROUP BY nc.period_id, nc.facilityid, nc.programid, nc.orderableid
),
lines AS (
    -- One row per product on the P0 requisition
    SELECT m.*, rli0.orderableid,
        rli0.beginningbalance AS shl_p0, rli0.totalconsumedquantity AS mc_p0, rli0.averageconsumption AS amc_p0,
        ROUND(rli0.stockonhand::numeric / NULLIF(rli0.averageconsumption, 0), 1) AS mos_p0,
        rli0.maximumstockquantity AS msq_p0
    FROM months m
    JOIN requisition.requisition_line_items rli0 ON rli0.requisitionid = m.requisition_p0
    WHERE COALESCE(rli0.skipped, false) = false
)
SELECT
    sf.district,
    sf.name AS facility,
    sf.type_name AS facility_type,
    prog.name AS program,
    l.reporting_month,
    pr.fullproductname AS product,
    pr.code AS product_code,
    rli2.beginningbalance::bigint AS shl_p2, f2.sh::bigint AS sh_p2, f2.qr::bigint AS qr_p2, f2.ti::bigint AS ti_p2,
    rli2.totalconsumedquantity::bigint AS mc_p2, rli2.averageconsumption::bigint AS amc_p2,
    ROUND(rli2.stockonhand::numeric / NULLIF(rli2.averageconsumption, 0), 1) AS mos_p2, rli2.maximumstockquantity::bigint AS msq_p2,
    rli1.beginningbalance::bigint AS shl_p1, f1.sh::bigint AS sh_p1, f1.qr::bigint AS qr_p1, f1.ti::bigint AS ti_p1,
    rli1.totalconsumedquantity::bigint AS mc_p1, rli1.averageconsumption::bigint AS amc_p1,
    ROUND(rli1.stockonhand::numeric / NULLIF(rli1.averageconsumption, 0), 1) AS mos_p1, rli1.maximumstockquantity::bigint AS msq_p1,
    (rli1.beginningbalance - f2.sh)::bigint AS var_p1,
    l.shl_p0::bigint AS shl_p0, f0.sh::bigint AS sh_p0, f0.qr::bigint AS qr_p0, f0.ti::bigint AS ti_p0,
    l.mc_p0::bigint AS mc_p0, l.amc_p0::bigint AS amc_p0, l.mos_p0, l.msq_p0::bigint AS msq_p0,
    (l.shl_p0 - f1.sh)::bigint AS var_p0,
    l.reporting_month_p1,
    l.reporting_month_p2
FROM lines l
JOIN selected_facilities sf ON sf.id = l.facilityid
CROSS JOIN params p
LEFT JOIN referencedata.programs prog ON prog.id = l.programid
LEFT JOIN products pr ON pr.id = l.orderableid
LEFT JOIN stock_figures f0 ON f0.period_id = l.period_p0 AND f0.facilityid = l.facilityid AND f0.programid = l.programid AND f0.orderableid = l.orderableid
LEFT JOIN stock_figures f1 ON f1.period_id = l.period_p1 AND f1.facilityid = l.facilityid AND f1.programid = l.programid AND f1.orderableid = l.orderableid
LEFT JOIN stock_figures f2 ON f2.period_id = l.period_p2 AND f2.facilityid = l.facilityid AND f2.programid = l.programid AND f2.orderableid = l.orderableid
LEFT JOIN requisition.requisition_line_items rli1 ON rli1.requisitionid = l.requisition_p1 AND rli1.orderableid = l.orderableid
LEFT JOIN requisition.requisition_line_items rli2 ON rli2.requisitionid = l.requisition_p2 AND rli2.orderableid = l.orderableid
WHERE (p.products IS NULL OR pr.fullproductname = ANY (p.products))
ORDER BY sf.district, sf.name, prog.name, l.startdate, pr.fullproductname]]>
	</queryString>
	<field name="district" class="java.lang.String"/>
	<field name="facility" class="java.lang.String"/>
	<field name="facility_type" class="java.lang.String"/>
	<field name="program" class="java.lang.String"/>
	<field name="reporting_month" class="java.lang.String"/>
	<field name="product" class="java.lang.String"/>
	<field name="product_code" class="java.lang.String"/>
	<field name="shl_p2" class="java.lang.Long"/>
	<field name="sh_p2" class="java.lang.Long"/>
	<field name="qr_p2" class="java.lang.Long"/>
	<field name="ti_p2" class="java.lang.Long"/>
	<field name="mc_p2" class="java.lang.Long"/>
	<field name="amc_p2" class="java.lang.Long"/>
	<field name="mos_p2" class="java.math.BigDecimal"/>
	<field name="msq_p2" class="java.lang.Long"/>
	<field name="shl_p1" class="java.lang.Long"/>
	<field name="sh_p1" class="java.lang.Long"/>
	<field name="qr_p1" class="java.lang.Long"/>
	<field name="ti_p1" class="java.lang.Long"/>
