		<parameterDescription><![CDATA[datepickers]]></parameterDescription>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="district" class="java.lang.String">
		<property name="displayName" value="District"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/geographicZones?page=0&amp;size=1000"/>
		<property name="selectProperty" value="name"/>
		<property name="displayProperty" value="name"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="facility" class="java.lang.String">
		<property name="displayName" value="Facility"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/facilities"/>
		<property name="selectProperty" value="name"/>
		<property name="displayProperty" value="name"/>
		<parameterDescription><![CDATA[multipleselect]]></parameterDescription>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="program" class="java.lang.String">
		<property name="displayName" value="Program"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/programs"/>
		<property name="selectProperty" value="name"/>
		<property name="displayProperty" value="name"/>
		<parameterDescription><![CDATA[multipleselect]]></parameterDescription>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="product" class="java.lang.String">
