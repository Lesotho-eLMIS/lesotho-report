	<parameter name="userId" class="java.lang.Object" isForPrompting="false"/>
	<queryString language="SQL">
		<![CDATA[WITH params AS (
    SELECT
        CASE WHEN p.start_date ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN p.start_date::date END AS start_date,
        CASE WHEN p.end_date ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN p.end_date::date END AS end_date,
        NULLIF(NULLIF(NULLIF(TRIM(p.district), ''), 'undefined'), 'null') AS district,
        CASE WHEN COALESCE(TRIM(p.facilities), '') IN ('', 'undefined', 'null') THEN NULL
             ELSE NULLIF(ARRAY(SELECT TRIM(x) FROM unnest(string_to_array(p.facilities, '|')) AS x WHERE TRIM(x) <> ''), '{}') END AS facilities,
        CASE WHEN COALESCE(TRIM(p.programs), '') IN ('', 'undefined', 'null') THEN NULL
             ELSE NULLIF(ARRAY(SELECT TRIM(x) FROM unnest(string_to_array(p.programs, '|')) AS x WHERE TRIM(x) <> ''), '{}') END AS programs,
        CASE WHEN COALESCE(TRIM(p.products), '') IN ('', 'undefined', 'null') THEN NULL
             ELSE NULLIF(ARRAY(SELECT TRIM(x) FROM unnest(string_to_array(p.products, '|')) AS x WHERE TRIM(x) <> ''), '{}') END AS products,
        CASE WHEN p.user_id ~* '^[0-9a-f-]{36}$' THEN p.user_id::uuid END AS user_id
    FROM (SELECT $P{startDate}::text AS start_date,
           $P{endDate}::text AS end_date,
           $P{district}::text AS district,
           $P{facility}::text AS facilities,
           $P{program}::text AS programs,
           $P{product}::text AS products,
           $P{userId}::text AS user_id
          OFFSET 0) AS p
),
facility_info AS (
    -- One row per facility with its district, resolved the same way as the reports page:
    -- the nearest zone named after one of the ten districts, else the zone at the district
    -- level, else the facility's parent zone (or its own zone when the parent is Lesotho).
    SELECT
        f.id,
        f.name,
        f.code,
        f.active,
        ft.id AS type_id,
        ft.name AS type_name,
        fo.name AS operator_name,
        COALESCE(
            (SELECT z.name
             FROM unnest(ARRAY[z1.name, z2.name, z3.name, z4.name]) WITH ORDINALITY AS z(name, ord)
             WHERE regexp_replace(LOWER(z.name), '[^a-z]', '', 'g') IN ('berea', 'buthabuthe', 'leribe', 'mafeteng', 'maseru', 'mohaleshoek', 'mokhotlong', 'qachasneck', 'qachasnek', 'quthing', 'thabatseka')
             ORDER BY z.ord
             LIMIT 1),
            CASE
                WHEN LOWER(l1.code) = 'district' OR l1.levelnumber = 3 THEN z1.name
                WHEN LOWER(l2.code) = 'district' OR l2.levelnumber = 3 THEN z2.name
                WHEN LOWER(l3.code) = 'district' OR l3.levelnumber = 3 THEN z3.name
            END,
            CASE WHEN z2.id IS NULL OR LOWER(z2.name) = 'lesotho' THEN z1.name ELSE z2.name END
        ) AS district,
        ARRAY[LOWER(z1.name), LOWER(z2.name), LOWER(z3.name), LOWER(z4.name)] AS zones
    FROM referencedata.facilities f
    LEFT JOIN referencedata.facility_types ft ON ft.id = f.typeid
    LEFT JOIN referencedata.facility_operators fo ON fo.id = f.operatedbyid
    LEFT JOIN referencedata.geographic_zones z1 ON z1.id = f.geographiczoneid
    LEFT JOIN referencedata.geographic_levels l1 ON l1.id = z1.levelid
    LEFT JOIN referencedata.geographic_zones z2 ON z2.id = z1.parentid
    LEFT JOIN referencedata.geographic_levels l2 ON l2.id = z2.levelid
    LEFT JOIN referencedata.geographic_zones z3 ON z3.id = z2.parentid
    LEFT JOIN referencedata.geographic_levels l3 ON l3.id = z3.levelid
    LEFT JOIN referencedata.geographic_zones z4 ON z4.id = z3.parentid
),
selected_facilities AS (
    -- Facilities matching the District and Facility filters
    SELECT fi.*
    FROM facility_info fi
    CROSS JOIN params p
    WHERE (p.district IS NULL
           OR LOWER(p.district) = LOWER(fi.district)
           OR LOWER(p.district) = ANY (fi.zones))
      AND (p.facilities IS NULL OR fi.name = ANY (p.facilities))
),
products AS (
    -- Latest version of each product (products are versioned)
    SELECT DISTINCT ON (o.id) o.id, o.code, o.fullproductname
    FROM referencedata.orderables o
    ORDER BY o.id, o.versionnumber DESC
),
transactions AS (
    -- Every stock card line item (receipts, issues, adjustments, stock counts)
    SELECT scli.id, scli.stockcardid, scli.occurreddate, scli.processeddate, scli.userid,
        CASE WHEN scli.sourceid IS NOT NULL THEN 'Receipt'
             WHEN scli.destinationid IS NOT NULL THEN 'Issue'
             WHEN scli.reasonid IS NOT NULL THEN 'Adjustment'
             ELSE 'Stock Count' END AS transaction_type,
        scli.reasonid,
        NULLIF(TRIM(scli.reasonfreetext), '') AS reason_text,
        COALESCE(scli.sourceid, scli.destinationid) AS node_id,
        NULLIF(TRIM(COALESCE(scli.sourcefreetext, scli.destinationfreetext)), '') AS node_text,
        COALESCE(NULLIF(TRIM(scli.documentnumber), ''), NULLIF(TRIM(scli.referencenumber), '')) AS reference,
        scli.quantity
    FROM stockmanagement.stock_card_line_items scli
    UNION ALL
    -- Adjustments entered during a stock count
    SELECT scli.id, scli.stockcardid, scli.occurreddate, scli.processeddate, scli.userid,
        'Stock Count Adjustment', pili.reasonid, NULL, NULL, NULL,
        COALESCE(NULLIF(TRIM(scli.documentnumber), ''), NULLIF(TRIM(scli.referencenumber), '')),
        pili.quantity
    FROM stockmanagement.physical_inventory_line_item_adjustments pili
    JOIN stockmanagement.stock_card_line_items scli ON scli.id = pili.stockcardlineitemid
)
SELECT
    t.occurreddate AS date,
    sf.district,
    sf.name AS facility,
    sf.type_name AS facility_type,
    sf.operator_name AS ownership,
    prog.name AS program,
    pr.code AS product_code,
    pr.fullproductname AS product,
    lot.lotcode AS batch_number,
    lot.expirationdate AS expiry_date,
    t.transaction_type,
    COALESCE(rsn.name, t.reason_text) AS reason,
    CASE
        WHEN t.transaction_type = 'Stock Count' THEN 'Count'
        WHEN t.transaction_type = 'Receipt' OR rsn.reasontype = 'CREDIT' THEN 'In'
        WHEN t.transaction_type = 'Issue' OR rsn.reasontype = 'DEBIT' THEN 'Out'
    END AS direction,
    t.quantity,
    COALESCE(nf.name, org.name, t.node_text) AS source_destination,
    t.reference,
    COALESCE(NULLIF(TRIM(CONCAT_WS(' ', usr.firstname, usr.lastname)), ''), usr.username) AS recorded_by,
    t.processeddate AS recorded_on
FROM transactions t
JOIN stockmanagement.stock_cards sc ON sc.id = t.stockcardid
JOIN selected_facilities sf ON sf.id = sc.facilityid
CROSS JOIN params p
LEFT JOIN referencedata.programs prog ON prog.id = sc.programid
LEFT JOIN products pr ON pr.id = sc.orderableid
LEFT JOIN referencedata.lots lot ON lot.id = sc.lotid
LEFT JOIN stockmanagement.stock_card_line_item_reasons rsn ON rsn.id = t.reasonid
LEFT JOIN stockmanagement.nodes n ON n.id = t.node_id
LEFT JOIN referencedata.facilities nf ON nf.id = n.referenceid AND n.isrefdatafacility
LEFT JOIN stockmanagement.organizations org ON org.id = n.referenceid AND NOT n.isrefdatafacility
LEFT JOIN referencedata.users usr ON usr.id = t.userid
WHERE sf.type_id IN ('0fbe2b5c-bd2b-46af-ba7f-63c14add59c7', '1096849c-84cd-4a94-8a7a-25d9f6e3911b')
  AND (p.start_date IS NULL OR t.occurreddate >= p.start_date)
  AND (p.end_date IS NULL OR t.occurreddate <= p.end_date)
  AND (p.programs IS NULL OR prog.name = ANY (p.programs))
  AND (p.products IS NULL OR pr.fullproductname = ANY (p.products))
  AND (p.user_id IS NULL OR EXISTS (
        SELECT 1 FROM referencedata.right_assignments ra
        WHERE ra.userid = p.user_id
          AND ra.rightname = 'STOCK_CARDS_VIEW'
          AND ra.facilityid = sc.facilityid
          AND ra.programid = sc.programid))
ORDER BY sf.district, sf.name, prog.name, pr.fullproductname, lot.lotcode, t.occurreddate, t.processeddate,
         t.transaction_type]]>
	</queryString>
	<field name="date" class="java.sql.Date"/>
	<field name="district" class="java.lang.String"/>
	<field name="facility" class="java.lang.String"/>
	<field name="facility_type" class="java.lang.String"/>
	<field name="ownership" class="java.lang.String"/>
	<field name="program" class="java.lang.String"/>
	<field name="product_code" class="java.lang.String"/>
	<field name="product" class="java.lang.String"/>
	<field name="batch_number" class="java.lang.String"/>
	<field name="expiry_date" class="java.sql.Date"/>
	<field name="transaction_type" class="java.lang.String"/>
	<field name="reason" class="java.lang.String"/>
	<field name="direction" class="java.lang.String"/>
	<field name="quantity" class="java.lang.Integer"/>
	<field name="source_destination" class="java.lang.String"/>
	<field name="reference" class="java.lang.String"/>
	<field name="recorded_by" class="java.lang.String"/>
	<field name="recorded_on" class="java.sql.Timestamp"/>
