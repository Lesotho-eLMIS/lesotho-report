<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Redistribution_Report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="elmis"/>
	
	<parameter name="startDate" class="java.lang.String">
		<property name="displayName" value="Start Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	
	<parameter name="endDate" class="java.lang.String">
		<property name="displayName" value="End Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	
	<parameter name="facility" class="java.lang.String">
		<property name="displayName" value="Facility Name"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>

	<parameter name="district" class="java.lang.String" nestedType="java.lang.String">
		<property name="displayName" value="District"/>
		<property name="required" value="false"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>

	
	<parameter name="userId" class="java.lang.String">
		<property name="displayName" value="User ID"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	
	<queryString language="SQL">
		<![CDATA[
SELECT
    issufac.name                                        AS issuing_facility,
    issudis.name                                        AS issuing_district,
    issufacty.name                                      AS issuing_facility_type,
    issufacop.name                                      AS issuing_ownership,
    prog.name                                           AS program,
    ord.fullproductname                                 AS product,
    lots.lotcode                                        AS batch_number,
    stcli.quantity                                      AS quantity,
    stcli.occurreddate                                  AS date_received,
    fac.name                                            AS receiving_facility,
    dis.name                                            AS receiving_district,
    facty.name                                          AS receiving_facility_type,
    facop.name                                          AS receiving_ownership
FROM stockmanagement.stock_card_line_items stcli
LEFT JOIN stockmanagement.stock_card_line_item_reasons stclir ON stcli.reasonid = stclir.id
LEFT JOIN stockmanagement.stock_cards stc ON stcli.stockcardid = stc.id
LEFT JOIN referencedata.orderables ord ON stc.orderableid = ord.id
LEFT JOIN referencedata.lots lots ON stc.lotid = lots.id
LEFT JOIN referencedata.program_orderables po ON ord.id = po.orderableid
LEFT JOIN referencedata.programs prog ON po.programid = prog.id
LEFT JOIN referencedata.facilities fac ON stc.facilityid = fac.id
LEFT JOIN referencedata.facility_types facty ON fac.typeid = facty.id
LEFT JOIN referencedata.facility_operators facop ON fac.operatedbyid = facop.id
LEFT JOIN referencedata.geographic_zones zone_fac ON zone_fac.id = fac.geographiczoneid
LEFT JOIN referencedata.geographic_zones dis ON zone_fac.parentid = dis.id
LEFT JOIN stockmanagement.nodes no ON stcli.sourceid = no.id
LEFT JOIN referencedata.facilities issufac ON CAST(no.referenceid AS uuid) = issufac.id
LEFT JOIN referencedata.geographic_zones zone_issufac ON zone_issufac.id = issufac.geographiczoneid
LEFT JOIN referencedata.geographic_zones issudis ON zone_issufac.parentid = issudis.id
LEFT JOIN referencedata.facility_types issufacty ON issufac.typeid = issufacty.id
LEFT JOIN referencedata.facility_operators issufacop ON issufac.operatedbyid = issufacop.id
WHERE stclir.id = 'e3fc3cf3-da18-44b0-a220-77c985202e06'
AND EXISTS (
    SELECT 1 
    FROM referencedata.right_assignments ra
    WHERE ra.rightname = 'STOCK_CARDS_VIEW'
    AND ra.userId = $P{userId}::uuid
    AND ra.facilityid = fac.id
)
AND issufacty.id IN (
    '0fbe2b5c-bd2b-46af-ba7f-63c14add59c7',
    '1096849c-84cd-4a94-8a7a-25d9f6e3911b'
)
AND facty.id IN (
    '0fbe2b5c-bd2b-46af-ba7f-63c14add59c7',
    '1096849c-84cd-4a94-8a7a-25d9f6e3911b'
)
AND stcli.sourceid IS NOT NULL
AND ($P{startDate} IS NULL OR $P{startDate} = '' OR stcli.occurreddate >= TO_TIMESTAMP(NULLIF($P{startDate}, ''), 'YYYY-MM-DD'))
AND ($P{endDate} IS NULL OR $P{endDate} = '' OR stcli.occurreddate < (TO_TIMESTAMP(NULLIF($P{endDate}, ''), 'YYYY-MM-DD') + INTERVAL '1 day'))
AND ($P{facility} IS NULL OR $P{facility} = '' OR issufac.name = $P{facility})
AND ($P{district} IS NULL OR $P{district} = '' OR issudis.name = $P{district})
ORDER BY issudis.name, issufac.name, dis.name, fac.name, stcli.occurreddate]]>
	</queryString>
	
