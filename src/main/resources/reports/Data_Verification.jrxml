<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Stockout_Report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail" uuid="bb100000-0000-0000-0000-000000000001">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="elmis"/>
	
	<!-- Clean Excel/CSV Export Properties -->
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.1" value="pageHeader"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.band.1" value="pageHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.band.2" value="pageFooter"/>

	<!-- Standardized OpenLMIS Parameters -->
	<parameter name="startDate" class="java.lang.String">
		<property name="displayName" value="Start Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="endDate" class="java.lang.String">
		<property name="displayName" value="End Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="facility" class="java.lang.String" nestedType="java.lang.String">
		<property name="displayName" value="Facility"/>
		<property name="required" value="false"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>

	<queryString language="SQL">
		<![CDATA[WITH daily AS (
    SELECT
        dis.name                        AS district_name,
        fac.id                          AS facility_id,
        fac.name                        AS facility_name,
        facty.name                      AS facility_type_name,
        prog.id                         AS program_id,
        prog.name                       AS program_name,
        ord.id                          AS orderable_id,
        ord.fullproductname             AS product_name,
        stcli.occurreddate::date        AS transaction_date,
        SUM(
            CASE
                WHEN COALESCE(stclire.reasontype, 'CREDIT') = 'CREDIT' THEN stcli.quantity
                WHEN stclire.reasontype = 'DEBIT' THEN -stcli.quantity
                ELSE 0
            END
        ) AS daily_movement_qty
    FROM stockmanagement.stock_card_line_items stcli
    LEFT JOIN stockmanagement.stock_card_line_item_reasons stclir
        ON stcli.reasonid = stclir.id
    JOIN stockmanagement.stock_cards stc
        ON stcli.stockcardid = stc.id
    JOIN referencedata.orderables ord
        ON stc.orderableid = ord.id
    JOIN referencedata.facilities fac
        ON stc.facilityid = fac.id
    LEFT JOIN referencedata.geographic_zones zone_fac
        ON zone_fac.id = fac.geographiczoneid
    LEFT JOIN referencedata.geographic_zones dis
        ON zone_fac.parentid = dis.id
    LEFT JOIN referencedata.facility_types facty
        ON fac.typeid = facty.id
    LEFT JOIN referencedata.program_orderables po
        ON po.orderableid = ord.id
    LEFT JOIN referencedata.programs prog
        ON po.programid = prog.id
    WHERE (
        $P{startDate} IS NULL OR $P{startDate} = ''
        OR stcli.occurreddate >= TO_TIMESTAMP(NULLIF($P{startDate}, ''), 'YYYY-MM-DD')
    )
    AND (
        $P{endDate} IS NULL OR $P{endDate} = ''
        OR stcli.occurreddate < (TO_TIMESTAMP(NULLIF($P{endDate}, ''), 'YYYY-MM-DD') + INTERVAL '1 day')
    )
    AND (
        $P{facility} IS NULL OR $P{facility} = ''
        OR fac.name = $P{facility}
    )
    GROUP BY
        dis.name,
        fac.id, fac.name, facty.name,
        prog.id, prog.name,
        ord.id, ord.fullproductname,
        stcli.occurreddate::date
),
balances AS (
    SELECT
        d.*,
        SUM(d.daily_movement_qty) OVER (
            PARTITION BY d.facility_id, d.orderable_id
            ORDER BY d.transaction_date
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS running_balance
    FROM daily d
),
marked AS (
    SELECT
        b.*,
        LAG(b.running_balance) OVER (
            PARTITION BY b.facility_id, b.orderable_id
            ORDER BY b.transaction_date
        ) AS prev_balance,
        (b.running_balance <= 0) AS is_stockout
    FROM balances b
),
episodes AS (
    SELECT
        m.*,
        CASE
            WHEN m.is_stockout = TRUE
             AND COALESCE(m.prev_balance > 0, TRUE) = TRUE
            THEN 1 ELSE 0
        END AS is_start
    FROM marked m
),
episode_id AS (
    SELECT
        e.*,
        SUM(e.is_start) OVER (
            PARTITION BY e.facility_id, e.orderable_id
            ORDER BY e.transaction_date
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS stockout_group
    FROM episodes e
    WHERE e.is_stockout = TRUE
),
stockout_summary AS (
    SELECT
        district_name,
        facility_id,
        facility_name,
        facility_type_name,
        program_id,
        program_name,
        orderable_id,
        product_name,
        MIN(transaction_date)   AS stockout_start_date,
        MAX(transaction_date)   AS last_stockout_date,
        MIN(running_balance)    AS min_balance_in_stockout,
        stockout_group
    FROM episode_id
    GROUP BY
        district_name,
        facility_id,
        facility_name,
        facility_type_name,
        program_id,
        program_name,
        orderable_id,
        product_name,
        stockout_group
),
final AS (
    SELECT
        s.*,
        (
            SELECT MIN(b2.transaction_date)
            FROM balances b2
            WHERE b2.facility_id   = s.facility_id
              AND b2.orderable_id  = s.orderable_id
              AND b2.transaction_date > s.last_stockout_date
              AND b2.running_balance > 0
        ) AS stockout_end_date
    FROM stockout_summary s
)
SELECT
    district_name,
    facility_name,
    facility_type_name,
    program_name,
    product_name,
    stockout_start_date,
    stockout_end_date,
    GREATEST(
        (COALESCE(stockout_end_date, CURRENT_DATE) - stockout_start_date)::int,
        0
    ) AS days_out_of_stock,
    min_balance_in_stockout AS running_balance
FROM final
ORDER BY district_name, facility_name, program_name, product_name, stockout_start_date]]>
	</queryString>
	<field name="district_name" class="java.lang.String"/>
	<field name="facility_name" class="java.lang.String"/>
	<field name="facility_type_name" class="java.lang.String"/>
	<field name="program_name" class="java.lang.String"/>
	<field name="product_name" class="java.lang.String"/>
	<field name="stockout_start_date" class="java.sql.Date"/>
	<field name="stockout_end_date" class="java.sql.Date"/>
	<field name="days_out_of_stock" class="java.lang.Integer"/>
	<field name="running_balance" class="java.lang.Long"/>
