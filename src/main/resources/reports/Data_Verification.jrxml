	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.band.1" value="pageHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.band.2" value="pageFooter"/>

	<!-- Standardized OpenLMIS Parameters -->
	<parameter name="startDate" class="java.lang.String">
		<property name="displayName" value="Start Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="endDate" class="java.lang.String">
		<property name="displayName" value="End Date"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="program" class="java.lang.String" nestedType="java.lang.String">
		<property name="displayName" value="Program"/>
		<property name="required" value="false"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="facility" class="java.lang.String" nestedType="java.lang.String">
		<property name="displayName" value="Facility"/>
		<property name="required" value="false"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	
	<!-- Internal Security Parameter (Do not display in UI) -->
	<parameter name="userId" class="java.lang.String">
		<property name="displayName" value="Delete from template parameters"/>
	</parameter>

	<queryString language="SQL">
		<![CDATA[
WITH user_rights AS (
    SELECT facilityid, programid
    FROM referencedata.right_assignments
    WHERE rightname = 'STOCK_CARDS_VIEW'
    AND userId = $P{userId}::uuid
)
SELECT
    fac.name AS "Facility",
    dis.name AS "District",
    facty.name AS "Facility Type",
    facop.name AS "Ownership",
    prog.name AS "Program",
    ord.fullproductname AS "Product",
    lots.lotcode AS "Batch Number",
    stcli.quantity AS "Quantity",
    stclir.name AS "Reason",
    stclir.reasontype AS "Reason Type",
    TO_CHAR(stcli.occurreddate, 'DD Month YYYY') AS "Occurred Date"
FROM stockmanagement.stock_card_line_items stcli
LEFT JOIN stockmanagement.stock_card_line_item_reasons stclir ON stcli.reasonid = stclir.id
LEFT JOIN stockmanagement.stock_cards stc ON stcli.stockcardid = stc.id
LEFT JOIN referencedata.orderables ord ON stc.orderableid = ord.id
LEFT JOIN referencedata.lots lots ON stc.lotid = lots.id
LEFT JOIN referencedata.program_orderables po ON ord.id = po.orderableid
LEFT JOIN referencedata.programs prog ON po.programid = prog.id
LEFT JOIN referencedata.facilities fac ON stc.facilityid = fac.id
LEFT JOIN referencedata.facility_types facty ON fac.typeid = facty.id
LEFT JOIN referencedata.facility_operators facop ON fac.operatedbyid = facop.id
LEFT JOIN referencedata.geographic_zones zone_fac ON zone_fac.id = fac.geographiczoneid
LEFT JOIN referencedata.geographic_zones dis ON zone_fac.parentid = dis.id
JOIN user_rights ur ON ur.facilityid = fac.id AND ur.programid = prog.id
WHERE facty.id IN (
    '0fbe2b5c-bd2b-46af-ba7f-63c14add59c7',
    '1096849c-84cd-4a94-8a7a-25d9f6e3911b'
)
AND (
    $P{startDate} IS NULL OR $P{startDate} = ''
    OR stcli.occurreddate >= TO_TIMESTAMP(NULLIF($P{startDate}, ''), 'YYYY-MM-DD')
)
AND (
    $P{endDate} IS NULL OR $P{endDate} = ''
    OR stcli.occurreddate < (TO_TIMESTAMP(NULLIF($P{endDate}, ''), 'YYYY-MM-DD') + INTERVAL '1 day')
)
AND (
    $P{facility} IS NULL OR $P{facility} = ''
    OR fac.name = $P{facility}
)
AND (
    $P{program} IS NULL OR $P{program} = ''
    OR prog.name = $P{program}
)
ORDER BY dis.name, fac.name,prog.name,lots.lotcode, stcli.occurreddate
		]]>
	</queryString>
