	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.band.1" value="pageHeader"/>
	<property name="net.sf.jasperreports.export.csv.exclude.origin.band.2" value="pageFooter"/>

	<!-- Standardized OpenLMIS Parameters -->
	<parameter name="facility" class="java.lang.String" nestedType="java.lang.String">
		<property name="displayName" value="Facility"/>
		<property name="required" value="false"/>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>

	<queryString language="SQL">
		<![CDATA[WITH stockmanagement AS (
    SELECT
        fac.name AS facility,
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Consumed' OR stclire_pili.name = 'Consumed') AS "Consumed",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Beginning Balance Insufficiency' OR stclire_pili.name = 'Beginning Balance Insufficiency') AS "Beginning Balance Insufficiency",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Facility Return' OR stclire_pili.name = 'Facility Return') AS "Facility Return",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Stolen' OR stclire_pili.name = 'Stolen') AS "Stolen",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Beginning Balance Excess' OR stclire_pili.name = 'Beginning Balance Excess') AS "Beginning Balance Excess",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Lost' OR stclire_pili.name = 'Lost') AS "Lost",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'POD Query' OR stclire_pili.name = 'POD Query') AS "POD Query",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Damage' OR stclire_pili.name = 'Damage') AS "Damage",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Expired' OR stclire_pili.name = 'Expired') AS "Expired",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Unusable' OR stclire_pili.name = 'Unusable') AS "Unusable",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Degraded' OR stclire_pili.name = 'Degraded') AS "Degraded",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Unpack Kit' OR stclire_pili.name = 'Unpack Kit') AS "Unpack Kit",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Transfer In' OR stclire_pili.name = 'Transfer In') AS "Transfer In",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Unpacked From Kit' OR stclire_pili.name = 'Unpacked From Kit') AS "Unpacked From Kit",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Transfer Out' OR stclire_pili.name = 'Transfer Out') AS "Transfer Out",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Cold Chain Failure' OR stclire_pili.name = 'Cold Chain Failure') AS "Cold Chain Failure",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Passed Open-vial Time Limit' OR stclire_pili.name = 'Passed Open-vial Time Limit') AS "Passed Open-vial Time Limit",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Recalled' OR stclire_pili.name = 'Recalled') AS "Recalled",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Over Supply' OR stclire_pili.name = 'Over Supply') AS "Over Supply",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Receipts' OR stclire_pili.name = 'Receipts') AS "Receipts",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Expiry' OR stclire_pili.name = 'Expiry') AS "Expiry",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Damaged' OR stclire_pili.name = 'Damaged') AS "Damaged",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Internal Transfer Out' OR stclire_pili.name = 'Internal Transfer Out') AS "Internal Transfer Out",
        MAX(se.processeddate) FILTER (WHERE stclire.name = 'Internal Transfer In' OR stclire_pili.name = 'Internal Transfer In') AS "Internal Transfer In"
    FROM referencedata.facilities fac
    LEFT JOIN stockmanagement.stock_events se ON se.facilityid::uuid = fac.id
    LEFT JOIN stockmanagement.stock_event_line_items seli ON se.id = seli.stockeventid
    LEFT JOIN stockmanagement.stock_card_line_item_reasons stclire ON stclire.id = seli.reasonid::uuid
    LEFT JOIN stockmanagement.physical_inventory_line_item_adjustments pili ON seli.id = pili.stockeventlineitemid
    LEFT JOIN stockmanagement.stock_card_line_item_reasons stclire_pili ON pili.reasonid::uuid = stclire_pili.id
    GROUP BY fac.name
),
requisitions AS (
    SELECT
        fac.name AS facility,
        MAX(rsc.createddate) AS "requisitions"
    FROM referencedata.facilities fac
    LEFT JOIN requisition.requisitions r ON r.facilityid = fac.id
    LEFT JOIN requisition.status_changes rsc ON rsc.requisitionid = r.id
    WHERE rsc.status IN ('INITIATED','SUBMITTED','AUTHORIZED')
    GROUP BY fac.name
),
fulfillment AS (
    SELECT
        fac.name AS facility,
        GREATEST(MAX(o.createddate::timestamp), MAX(ship.shippeddate::timestamp)) AS "fulfillment"
    FROM referencedata.facilities fac
    LEFT JOIN fulfillment.orders o ON o.facilityid::uuid = fac.id
    LEFT JOIN fulfillment.shipments ship ON ship.orderid = o.id
    GROUP BY fac.name
)
SELECT
    st.facility,
    st."Consumed",
    st."Beginning Balance Insufficiency",
    st."Facility Return",
    st."Stolen",
    st."Beginning Balance Excess",
    st."Lost",
    st."POD Query",
    st."Damage",
    st."Expired",
    st."Unusable",
    st."Degraded",
    st."Unpack Kit",
    st."Transfer In",
    st."Unpacked From Kit",
    st."Transfer Out",
    st."Cold Chain Failure",
    st."Passed Open-vial Time Limit",
    st."Recalled",
    st."Over Supply",
    st."Receipts",
    st."Expiry",
    st."Damaged",
    st."Internal Transfer Out",
    st."Internal Transfer In",
    r.requisitions,
    f.fulfillment
FROM stockmanagement st
JOIN requisitions r ON st.facility = r.facility
JOIN fulfillment f ON f.facility = st.facility
WHERE (
    CAST($P{facility} AS VARCHAR) IS NULL
    OR st.facility = CAST($P{facility} AS VARCHAR)
)
ORDER BY st.facility]]>
	</queryString>
